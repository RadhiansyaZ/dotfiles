{
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "atlassian@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "effortLevel": "high",
  "theme": "dark",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(*)",
      "Edit"
    ],
    "ask": [
      "Bash(chown:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(rm:*)",
      "Bash(sudo:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf *:*)",
      "Bash(mkfs:*)",
      "Bash(docker push:*)",
      "Bash(npm publish:*)",
      "Bash(terraform destroy:*)",
      "Bash(aws s3 rm:*)"
    ]
  }
}
